# NE8000 Manager licence store settings. Copy to .env on the store server and fill in.
# Never commit .env or paste these values in chat.

# --- Addresses (DNS for both must point at this server)
STORE_SALES_HOST=ne8000.example.com
STORE_BILLING_HOST=billing.ne8000.example.com
# Where buyers' apps and Daraja reach the store (the billing address, with https://)
STORE_PUBLIC_URL=https://billing.ne8000.example.com
STORE_NAME=Yubo

# --- Admin page (https://billing.../admin)
STORE_ADMIN_PASSWORD=
STORE_ADMIN_EMAIL=

# --- Prices (USD). Monthly licence: first device + each extra device. Hosting = DigitalOcean price + markup %.
STORE_PERIOD=month
STORE_FIRST_DEVICE_USD=100
STORE_EXTRA_DEVICE_USD=30
STORE_HOSTING_MARKUP=30
STORE_KES_PER_USD=129
STORE_GRACE_DAYS=7

# --- M-Pesa (Safaricom Daraja, Lipa na M-Pesa Online). Start with MPESA_ENV=sandbox.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Only for a till (Buy Goods): the till number. Leave empty for a paybill.
MPESA_TILL=
# Any long random string; it becomes part of the callback URL
MPESA_CALLBACK_SECRET=

# --- Bank transfer details shown to buyers
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT=
BANK_PAYBILL=

# --- DigitalOcean (hosted installs). Leave DO_TOKEN empty to offer own-server only.
DO_TOKEN=
DO_REGION=fra1
DO_SSH_KEYS=
DO_PROJECT_ID=

# --- Email (login details, invoices). Empty SMTP_HOST = emails are saved in data/outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
