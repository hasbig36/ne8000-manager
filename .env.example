# Copy to .env and adjust. Every setting is optional.

# First admin login. If NE8000_ADMIN_PASSWORD is empty, a random password is
# printed once in the log on first start (docker compose logs ne8000).
NE8000_ADMIN_USER=admin
NE8000_ADMIN_PASSWORD=

# Set to 1 when a reverse proxy (Caddy, nginx) serves the app over HTTPS.
# Makes the login cookie HTTPS-only and trusts X-Forwarded-For / -Proto from the proxy.
NE8000_BEHIND_PROXY=1

# Listen on all addresses (LAN / VPN use without HTTPS). Leave unset behind a reverse proxy.
# NE8000_BIND=0.0.0.0

# Domain for the bundled Caddy (docker compose --profile https up -d)
NE8000_DOMAIN=ne8000.example.com

# Routers are normally added in the app under Manager > Routers. Once one is saved,
# the app only connects to saved routers. This adds extra allowed routers
# (IPs, subnets or hostnames, comma-separated). Both empty = any.
# NE8000_ALLOWED_ROUTERS=192.0.2.1,10.10.0.0/24

# Pre-fill the router form (only used while no routers are saved)
# NE8000_DEFAULT_HOST=192.0.2.1
# NE8000_DEFAULT_PORT=22

# Show the "Try demo mode" button (1/0)
NE8000_ALLOW_DEMO=0

# How long a sign-in lasts, in hours
NE8000_SESSION_HOURS=12

# Worker threads (one process; router sessions live in its memory)
NE8000_THREADS=16
